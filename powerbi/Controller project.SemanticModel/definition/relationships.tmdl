relationship Fact_EVM_Snapshots_Dim_Project
	fromColumn: Fact_EVM_Snapshots.project_id
	toColumn: Dim_Project.project_id

relationship Fact_EVM_Snapshots_Dim_Date
	fromCardinality: many
	toCardinality: many
	fromColumn: Fact_EVM_Snapshots.reporting_period
	toColumn: Dim_Date.ReportingPeriod
	crossFilteringBehavior: bothDirections
